{
  "name": "time-convert",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build --base=/timeconvert/",
    "build:cf": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build:cf && npx wrangler pages deploy dist",
    "cf:dev": "npx wrangler pages dev dist"
  },
  "dependencies": {
    "dayjs": "^1.11.19",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "naive-ui": "^2.43.2",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.0",
    "vite-plugin-compression2": "^2.4.0",
    "vue-tsc": "^2.2.2",
    "wrangler": "^3.0.0"
  }
}
